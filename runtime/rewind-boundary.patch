+// Rewind at the same safe boundary as a file load. The input edge is
+// dispatched inside a video timer whose bookkeeping still owns the old time.
+void running_machine::schedule_rewind()
+{
+	if (m_saveload_schedule == saveload_schedule::NONE)
+	{
+		m_saveload_schedule_time = time();
+		m_saveload_schedule = saveload_schedule::REWIND;
+	}
+}
