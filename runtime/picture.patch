+	// The player can filter the game image without filtering UI cards or text.
+	static void draw_game_quad(render_primitive const &prim, PixelType *pixels, u32 width, u32 height, u32 pitch, u8 picture)
+	{
+		setup_and_draw_textured_quad(prim, pixels, width, height, pitch);
+		if (!(picture & 2)) return;
+		int const x0 = std::clamp<int>(round_nearest(prim.bounds.x0), 0, int(width));
+		int const x1 = std::clamp<int>(round_nearest(prim.bounds.x1), 0, int(width));
+		int const y0 = std::clamp<int>(round_nearest(prim.bounds.y0), 0, int(height));
+		int const y1 = std::clamp<int>(round_nearest(prim.bounds.y1), 0, int(height));
+		int const span = y1 - y0;
+		int const bands = std::min(int(prim.texture.height) * 2, span);
+		for (int y = y0; y < y1; ++y)
+		{
+			if (!(((y-y0) * bands / span) & 1)) continue;
+			auto *row = pixels + y * pitch;
+			for (int x = x0; x < x1; ++x)
+			{
+				auto const p = row[x];
+				auto const colour = dest_assemble_rgb(dest_r(p)*3/4, dest_g(p)*3/4, dest_b(p)*3/4);
+				row[x] = (p & ~dest_rgb_to_pixel(255, 255, 255)) | colour;
+			}
+		}
+	}
