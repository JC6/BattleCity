{
  "name": "battlecity-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run bundle --",
    "bundle": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:deploy": "node scripts/test-production.mjs"
  },
  "dependencies": { "phaser": "4.2.1" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
